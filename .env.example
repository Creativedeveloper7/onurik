# Repo root `.env` (Vite reads from here via website/vite.config.js envDir)

# Include https:// — `projectref.supabase.co` alone will error in the browser client
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Must match Postgres: update public.onurik_site_settings set value = to_jsonb('YOUR_SECRET'::text)
#   where key = 'dashboard_read_secret';
VITE_ADMIN_DASHBOARD_SECRET=your-dashboard-read-secret

# Optional: alternatively paste keys into HTML `window.__ONURIK_PUBLIC_CONFIG__` before </head>
# on contact.html and admin enquiries/bookings (no rebuild)    .

# Shop e-receipts (Resend). Sent automatically after a successful checkout.
# Verify your domain in Resend, then set a from-address on that domain.
# Also add these three keys in the Vercel project (Production + Preview).
# A repo-root .env is local only and is not deployed.
RESEND_API_KEY=
SHOP_RECEIPT_FROM=Onurik Shop <jason@onurik.space>
SHOP_RECEIPT_BCC=jason@onurik.space

# Wallee hosted checkout (publishable key — safe in the browser).
# Allow https://www.onurik.space on the key. Local Vite uses /walle-api so Origin checks pass.
# Also set these on Vercel (Production + Preview).
VITE_WALLE_PUBLISHABLE_KEY=wpub_test_YOUR_KEY
VITE_WALLE_API_URL=https://pmtlwsdythsngetkaalq.supabase.co/functions/v1/api
# Optional. HMAC for success-URL query params (wallee_session, status, reference, ts, sig).
# Fulfilment still re-checks GET /v1/checkout/sessions/:id until status is paid.
CHECKOUT_SIGNING_SECRET=

